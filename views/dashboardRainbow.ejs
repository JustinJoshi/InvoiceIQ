<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>InvoiceIQ - Personal Metrics Dashboard</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #3b82f6;
            --primary-hover: #2563eb;
            --secondary: #8b5cf6;
            --background: #000000;
            --surface: #0a0a0a;
            --text-primary: #ffffff;
            --text-secondary: #a0a0a0;
            --border: #1a1a1a;
            --success: #10b981;
            --warning: #f59e0b;
            --error: #ef4444;
        }

        @keyframes rainbow-border {
            0% {
                background-position: 0% 50%;
            }

            50% {
                background-position: 100% 50%;
            }

            100% {
                background-position: 0% 50%;
            }
        }

        @keyframes glow {

            0%,
            100% {
                opacity: 1;
            }

            50% {
                opacity: 0.7;
            }
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: var(--background);
            color: var(--text-primary);
            overflow-x: hidden;
        }

        .app-container {
            display: flex;
            min-height: 100vh;
            width: 100%;
        }

        /* Rainbow border effect */
        .rainbow-border {
            position: relative;
            background: var(--surface);
            border-radius: 1rem;
        }

        .rainbow-border::before {
            content: '';
            position: absolute;
            top: -1px;
            left: -1px;
            right: -1px;
            bottom: -1px;
            background: linear-gradient(90deg,
                    #ff0080, #ff0080, #ff8c00, #40e0d0, #4169e1, #8a2be2, #ff0080);
            background-size: 300% 300%;
            border-radius: 1rem;
            z-index: -1;
            animation: rainbow-border 6s ease infinite;
        }

        .rainbow-border-static {
            position: relative;
            background: var(--surface);
            border-radius: 1rem;
        }

        .rainbow-border-static::before {
            content: '';
            position: absolute;
            top: -1px;
            left: -1px;
            right: -1px;
            bottom: -1px;
            background: linear-gradient(135deg,
                    #ff0080 0%, #ff8c00 25%, #40e0d0 50%, #4169e1 75%, #8a2be2 100%);
            border-radius: 1rem;
            z-index: -1;
            opacity: 0.6;
        }

        /* Sidebar */
        .sidebar {
            width: 16rem;
            background: var(--surface);
            border-right: 1px solid #1a1a1a;
            padding: 1.5rem;
            position: fixed;
            height: 100vh;
            overflow-y: auto;
            flex-shrink: 0;
        }

        .sidebar-header {
            margin-bottom: 2rem;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            font-size: 1.5rem;
            font-weight: 700;
        }

        .logo-icon {
            font-size: 2rem;
            background: linear-gradient(135deg, #ff0080, #ff8c00, #40e0d0);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .sidebar-nav {
            display: flex;
            flex-direction: column;
            gap: 2rem;
        }

        .nav-section-title {
            font-size: 0.75rem;
            font-weight: 600;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 0.5rem;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.75rem 1rem;
            border-radius: 0.5rem;
            color: var(--text-secondary);
            text-decoration: none;
            transition: all 0.2s ease;
            font-size: 0.875rem;
        }

        .nav-item:hover {
            background: rgba(255, 255, 255, 0.05);
            color: var(--text-primary);
        }

        .nav-item.active {
            background: linear-gradient(135deg, rgba(255, 0, 128, 0.2), rgba(64, 224, 208, 0.2));
            color: white;
            border: 1px solid rgba(255, 0, 128, 0.3);
        }

        .nav-icon {
            width: 1.25rem;
            height: 1.25rem;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* SVG Icons */
        .icon {
            width: 100%;
            height: 100%;
            stroke: currentColor;
            fill: none;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        /* Main Content */
        .main-content {
            flex: 1;
            margin-left: 16rem;
            width: calc(100% - 16rem);
        }

        .top-nav {
            background: var(--surface);
            border-bottom: 1px solid #1a1a1a;
            padding: 1rem 2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 100;
            backdrop-filter: blur(10px);
        }

        .breadcrumb {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            color: var(--text-secondary);
            font-size: 0.875rem;
        }

        .top-nav-right {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .search-input {
            padding: 0.5rem 1rem;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 0.5rem;
            color: var(--text-primary);
            font-size: 0.875rem;
            width: 15rem;
            transition: all 0.2s ease;
        }

        .search-input:focus {
            outline: none;
            border-color: #ff0080;
            background: rgba(255, 255, 255, 0.08);
        }

        /* Dashboard Content */
        .dashboard-content {
            padding: 2rem;
            max-width: 100%;
        }

        .dashboard-header {
            margin-bottom: 2rem;
        }

        .dashboard-title {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .dashboard-title h1 {
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 0.25rem;
            background: linear-gradient(135deg, #ff0080, #ff8c00, #40e0d0);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .dashboard-actions {
            display: flex;
            gap: 0.75rem;
            align-items: center;
        }

        .btn-icon {
            padding: 0.5rem;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 0.5rem;
            cursor: pointer;
            font-size: 1.25rem;
            transition: all 0.2s ease;
            color: var(--text-primary);
        }

        .btn-icon:hover {
            background: rgba(255, 255, 255, 0.1);
            border-color: #ff0080;
        }

        .btn-secondary {
            padding: 0.5rem 1rem;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 0.5rem;
            color: var(--text-primary);
            cursor: pointer;
            font-size: 0.875rem;
            font-weight: 500;
            transition: all 0.2s ease;
        }

        .btn-secondary:hover {
            background: rgba(255, 255, 255, 0.1);
            border-color: #40e0d0;
        }

        .btn-primary {
            padding: 0.5rem 1rem;
            background: linear-gradient(135deg, #ff0080, #ff8c00);
            border: none;
            border-radius: 0.5rem;
            color: white;
            cursor: pointer;
            font-size: 0.875rem;
            font-weight: 600;
            transition: all 0.2s ease;
        }

        .btn-primary:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 20px rgba(255, 0, 128, 0.4);
        }

        /* Stats Grid */
        .dashboard-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
            gap: 1.5rem;
            margin-bottom: 2rem;
        }

        .stat-card {
            padding: 1.5rem;
            transition: all 0.3s ease;
            cursor: pointer;
        }

        .stat-card:hover {
            transform: translateY(-4px) scale(1.02);
            box-shadow: 0 12px 40px rgba(255, 0, 128, 0.2);
        }

        .stat-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 1rem;
        }

        .stat-title {
            font-size: 0.875rem;
            color: var(--text-secondary);
            font-weight: 500;
        }

        .stat-icon {
            width: 2.5rem;
            height: 2.5rem;
            border-radius: 0.5rem;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
        }

        .stat-icon.blue {
            background: rgba(59, 130, 246, 0.15);
            color: #60a5fa;
        }

        .stat-icon.green {
            background: rgba(16, 185, 129, 0.15);
            color: #34d399;
        }

        .stat-icon.orange {
            background: rgba(245, 158, 11, 0.15);
            color: #fbbf24;
        }

        .stat-icon.purple {
            background: rgba(139, 92, 246, 0.15);
            color: #a78bfa;
        }

        .stat-value {
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
        }

        .stat-change {
            display: flex;
            align-items: center;
            gap: 0.25rem;
            font-size: 0.875rem;
        }

        .stat-change.positive {
            color: var(--success);
        }

        .stat-change.negative {
            color: var(--error);
        }

        /* Chart Panel */
        .chart-panel {
            padding: 1.5rem;
            margin-bottom: 2rem;
        }

        .panel-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 1.5rem;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .panel-title {
            font-size: 1.25rem;
            font-weight: 600;
        }

        .chart-container {
            width: 100%;
            height: 20rem;
            position: relative;
        }

        /* Data Table */
        .data-table {
            overflow: hidden;
        }

        .table {
            width: 100%;
            border-collapse: collapse;
        }

        .table thead {
            background: rgba(255, 255, 255, 0.02);
        }

        .table th {
            padding: 1rem;
            text-align: left;
            font-size: 0.875rem;
            font-weight: 600;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .table td {
            padding: 1rem;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
            font-size: 0.875rem;
        }

        .table tbody tr {
            transition: all 0.2s ease;
        }

        .table tbody tr:hover {
            background: rgba(255, 0, 128, 0.05);
        }

        .badge {
            padding: 0.25rem 0.75rem;
            border-radius: 9999px;
            font-size: 0.75rem;
            font-weight: 600;
        }

        .badge-success {
            background: rgba(16, 185, 129, 0.15);
            color: var(--success);
            border: 1px solid rgba(16, 185, 129, 0.3);
        }

        /* Responsive */
        @media (max-width: 1024px) {
            .sidebar {
                width: 14rem;
            }

            .main-content {
                margin-left: 14rem;
                width: calc(100% - 14rem);
            }

            .dashboard-grid {
                grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
            }
        }

        @media (max-width: 768px) {
            .sidebar {
                transform: translateX(-100%);
                position: fixed;
            }

            .main-content {
                margin-left: 0;
                width: 100%;
            }

            .top-nav {
                padding: 1rem;
            }

            .search-input {
                width: 10rem;
            }

            .dashboard-content {
                padding: 1rem;
            }

            .dashboard-title {
                flex-direction: column;
                align-items: flex-start;
            }

            .dashboard-actions {
                width: 100%;
                flex-wrap: wrap;
            }

            .dashboard-grid {
                grid-template-columns: 1fr;
            }

            .chart-container {
                height: 15rem;
            }

            .table {
                font-size: 0.75rem;
            }

            .table th,
            .table td {
                padding: 0.75rem 0.5rem;
            }
        }
    </style>
</head>

<body>
    <div class="app-container">
        <!-- Sidebar -->
        <aside class="sidebar">
            <div class="sidebar-header">
                <div class="logo">
                    <div class="logo-icon">◆</div>
                    <span>InvoiceIQ</span>
                </div>
            </div>

            <nav class="sidebar-nav">
                <div class="nav-section">
                    <div class="nav-section-title">Main</div>
                    <a href="/dashboard" class="nav-item active">
                        <div class="nav-icon">
                            <svg class="icon" viewBox="0 0 24 24">
                                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                                <polyline points="9 22 9 12 15 12 15 22"></polyline>
                            </svg>
                        </div>
                        <span>Dashboard</span>
                    </a>
                </div>

                <div class="nav-section">
                    <div class="nav-section-title">Data Sources</div>
                    <a href="/addSource" class="nav-item">
                        <div class="nav-icon">
                            <svg class="icon" viewBox="0 0 24 24">
                                <line x1="12" y1="5" x2="12" y2="19"></line>
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                            </svg>
                        </div>
                        <span>Add Source</span>
                    </a>
                </div>
            </nav>
        </aside>

        <!-- Main Content -->
        <main class="main-content">
            <header class="top-nav">
                <div class="breadcrumb">
                    <span>InvoiceIQ</span>
                    <span>/</span>
                    <span>Dashboard</span>
                </div>

                <div class="top-nav-right">
                    <input type="text" class="search-input" placeholder="Search metrics...">
                </div>
            </header>

            <div class="dashboard-content">
                <div class="dashboard-header">
                    <div class="dashboard-title">
                        <div>
                            <h1>Dashboard Overview</h1>
                            <p style="color: var(--text-secondary);">Monitor your personal metrics in real-time</p>
                        </div>
                        <div class="dashboard-actions">
                            <!-- <button class="btn-icon">
                                <svg class="icon" viewBox="0 0 24 24" style="width: 1.25rem; height: 1.25rem;">
                                    <polyline points="23 4 23 10 17 10"></polyline>
                                    <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
                                </svg>
                            </button> -->
                            <form action="/dashboard">
                                <button class="btn-secondary">Switch Themes!</button>
                            </form>
                            <!-- <button class="btn-secondary">⏱️ Last 7 days</button>
                            <button class="btn-primary">➕ Add Panel</button> -->
                        </div>
                    </div>
                </div>

                <!-- Stats Grid -->
                <div class="dashboard-grid">
                    <div class="stat-card rainbow-border">
                        <div class="stat-header">
                            <span class="stat-title">Daily Steps</span>
                            <div class="stat-icon blue">
                                <svg class="icon" viewBox="0 0 24 24">
                                    <path d="M18 20V10"></path>
                                    <path d="M12 20V4"></path>
                                    <path d="M6 20v-6"></path>
                                </svg>
                            </div>
                        </div>
                        <div class="stat-value">8,247</div>
                        <div class="stat-change positive">
                            <span>↑</span>
                            <span>12% from last week</span>
                        </div>
                    </div>

                    <div class="stat-card rainbow-border">
                        <div class="stat-header">
                            <span class="stat-title">Active Hours</span>
                            <div class="stat-icon green">
                                <svg class="icon" viewBox="0 0 24 24">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <polyline points="12 6 12 12 16 14"></polyline>
                                </svg>
                            </div>
                        </div>
                        <div class="stat-value">6.5h</div>
                        <div class="stat-change positive">
                            <span>↑</span>
                            <span>8% from last week</span>
                        </div>
                    </div>

                    <div class="stat-card rainbow-border">
                        <div class="stat-header">
                            <span class="stat-title">Calories Burned</span>
                            <div class="stat-icon orange">
                                <svg class="icon" viewBox="0 0 24 24">
                                    <path d="M12 2v20M2 12h20"></path>
                                    <path
                                        d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z">
                                    </path>
                                </svg>
                            </div>
                        </div>
                        <div class="stat-value">2,145</div>
                        <div class="stat-change negative">
                            <span>↓</span>
                            <span>3% from last week</span>
                        </div>
                    </div>

                    <div class="stat-card rainbow-border">
                        <div class="stat-header">
                            <span class="stat-title">Sleep Quality</span>
                            <div class="stat-icon purple">
                                <svg class="icon" viewBox="0 0 24 24">
                                    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
                                </svg>
                            </div>
                        </div>
                        <div class="stat-value">87%</div>
                        <div class="stat-change positive">
                            <span>↑</span>
                            <span>5% from last week</span>
                        </div>
                    </div>
                </div>

                <!-- Chart Panel -->
                <div class="chart-panel rainbow-border-static">
                    <div class="panel-header">
                        <h3 class="panel-title">Activity Trends</h3>
                    </div>
                    <div class="chart-container">
                        <canvas id="activityChart"></canvas>
                    </div>
                </div>

                <!-- Activity Table -->
                <div class="data-table rainbow-border-static">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Category</th>
                                <th>Name</th>
                                <th>Value</th>
                                <th>Date</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody id="tbody">
                        </tbody>
                    </table>
                </div>
            </div>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script src="main.js"></script>
</body>

</html>