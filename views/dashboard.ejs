<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>InvoiceIQ - Personal Metrics Dashboard</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <!-- style & layout by claude -->
    <style>
        :root {
            --primary: #3b82f6;
            --primary-hover: #2563eb;
            --secondary: #8b5cf6;
            --background: #0f172a;
            --surface: #1e293b;
            --text-primary: #f8fafc;
            --text-secondary: #cbd5e1;
            --border: #334155;
            --success: #10b981;
            --warning: #f59e0b;
            --error: #ef4444;
        }

        @keyframes rainbow-border {
            0% {
                background-position: 0% 50%;
            }

            50% {
                background-position: 100% 50%;
            }

            100% {
                background-position: 0% 50%;
            }
        }

        @keyframes glow {

            0%,
            100% {
                opacity: 1;
            }

            50% {
                opacity: 0.7;
            }
        }


        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        .bigCont{
            display: flex;
            flex-flow: column;
            align-items: center;
            gap: 30px;
        }

        .noteInput{
            color: #1e293b;
            width: 1000px;
            height: 200px;
            background-color: #1e293b;
        }

        .formButton{
            width: 50px;
            margin: auto;
        }

        .anchor{
            margin: auto;
        }

        .anchorCont{
            margin-top: 40px;
            display: flex;
        }

        .form-label{
            margin: auto;
        }

        form{
            width: 100%;
            display: flex;
            flex-flow: column;
            gap: 30px;
        }

        .form-control {
            width: 100%;
            padding: 0.75rem 1rem;
            background: var(--background);
            border: 1px solid var(--border);
            border-radius: 0.5rem;
            color: var(--text-primary);
            font-size: 0.875rem;
        }

        .form-control:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
        }

        .invCont{
            display: flex;
            justify-content: space-around;
            gap: 60px;
            width: 100%;
            align-items: center;
        }

        .smallCont{
            width: 100%;
        }

        a:visited{
            color: white;
        }

        a{
            color: white;
        }



        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: var(--background);
            color: var(--text-primary);
            overflow-x: hidden;
        }

        .app-container {
            display: flex;
            min-height: 100vh;
            width: 100%;
        }

        /* Sidebar */
        .sidebar {
            width: 16rem;
            background: var(--surface);
            border-right: 1px solid var(--border);
            padding: 1.5rem;
            position: fixed;
            height: 100vh;
            overflow-y: auto;
            flex-shrink: 0;
        }

        .sidebar-header {
            margin-bottom: 2rem;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            font-size: 1.5rem;
            font-weight: 700;
        }

        .logo-icon {
            font-size: 2rem;
        }

        .sidebar-nav {
            display: flex;
            flex-direction: column;
            gap: 2rem;
        }

        .nav-section-title {
            font-size: 0.75rem;
            font-weight: 600;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 0.5rem;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.75rem 1rem;
            border-radius: 0.5rem;
            color: var(--text-secondary);
            text-decoration: none;
            transition: all 0.2s ease;
            font-size: 0.875rem;
        }

        .nav-item:hover {
            background: var(--background);
            color: var(--text-primary);
        }

        .nav-item.active {
            background: var(--primary);
            color: white;
        }

        /* Main Content */
        .main-content {
            flex: 1;
            margin-left: 16rem;
            width: calc(100% - 16rem);
        }

        .top-nav {
            background: var(--surface);
            border-bottom: 1px solid var(--border);
            padding: 1rem 2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .breadcrumb {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            color: var(--text-secondary);
            font-size: 0.875rem;
        }

        .top-nav-right {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .search-input {
            padding: 0.5rem 1rem;
            background: var(--background);
            border: 1px solid var(--border);
            border-radius: 0.5rem;
            color: var(--text-primary);
            font-size: 0.875rem;
            width: 15rem;
        }

        .search-input:focus {
            outline: none;
            border-color: var(--primary);
        }

        .user-menu {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .user-avatar {
            width: 2rem;
            height: 2rem;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--primary), var(--secondary));
        }

        /* Dashboard Content */
        .dashboard-content {
            padding: 2rem;
            max-width: 100%;
        }

        .dashboard-header {
            margin-bottom: 2rem;
        }

        .dashboard-title {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .dashboard-title h1 {
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 0.25rem;
        }

        .dashboard-actions {
            display: flex;
            gap: 0.75rem;
            align-items: center;
        }

        .btn-icon {
            padding: 0.5rem;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 0.5rem;
            cursor: pointer;
            font-size: 1.25rem;
            transition: all 0.2s ease;
        }

        .btn-icon:hover {
            background: var(--border);
        }

        .btn-secondary {
            padding: 0.5rem 1rem;
            background: var(--surface);
            border: .1px solid var(--border);
            border-radius: 1rem;
            color: var(--text-primary);
            cursor: pointer;
            font-size: 0.875rem;
            font-weight: 500;
            transition: all 0.2s ease;
        }

        .btn-secondary:hover {
            background: var(--border);
        }

        .btn-primary {
            padding: 0.5rem 1rem;
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            border: none;
            border-radius: 0.5rem;
            color: white;
            cursor: pointer;
            font-size: 0.875rem;
            font-weight: 600;
            transition: all 0.2s ease;
        }

        .btn-primary:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
        }

        /* Stats Grid */
        .dashboard-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
            gap: 1.5rem;
            margin-bottom: 2rem;
        }

        .stat-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 1rem;
            padding: 1.5rem;
            transition: all 0.2s ease;
        }

        .stat-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
        }

        .stat-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 1rem;
        }

        .stat-title {
            font-size: 0.875rem;
            color: var(--text-secondary);
            font-weight: 500;
        }

        .stat-icon {
            width: 2.5rem;
            height: 2.5rem;
            border-radius: 0.5rem;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
        }

        .stat-icon.blue {
            background: rgba(59, 130, 246, 0.1);
        }

        .stat-icon.green {
            background: rgba(16, 185, 129, 0.1);
        }

        .stat-icon.orange {
            background: rgba(245, 158, 11, 0.1);
        }

        .stat-icon.purple {
            background: rgba(139, 92, 246, 0.1);
        }

        .stat-value {
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
        }

        .stat-change {
            display: flex;
            align-items: center;
            gap: 0.25rem;
            font-size: 0.875rem;
        }

        .stat-change.positive {
            color: var(--success);
        }

        .stat-change.negative {
            color: var(--error);
        }

        /* Chart Panel */
        .chart-panel {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 1rem;
            padding: 1.5rem;
            margin-bottom: 2rem;
        }

        .panel-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 1.5rem;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .panel-title {
            font-size: 1.25rem;
            font-weight: 600;
        }

        .time-range-selector {
            display: flex;
            gap: 0.5rem;
        }

        .time-range-btn {
            padding: 0.5rem 1rem;
            background: transparent;
            border: 1px solid var(--border);
            border-radius: 0.5rem;
            color: var(--text-secondary);
            cursor: pointer;
            font-size: 0.875rem;
            transition: all 0.2s ease;
        }

        .time-range-btn:hover {
            background: var(--background);
        }

        .time-range-btn.active {
            background: var(--primary);
            color: white;
            border-color: var(--primary);
        }

        .chart-container {
            width: 100%;
            height: 20rem;
            position: relative;
        }

        /* Data Table */
        .data-table {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 1rem;
            overflow: hidden;
        }

        .table {
            width: 100%;
            border-collapse: collapse;
        }

        .table thead {
            background: var(--background);
        }

        .table th {
            padding: 1rem;
            text-align: left;
            font-size: 0.875rem;
            font-weight: 600;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .table td {
            padding: 1rem;
            border-top: 1px solid var(--border);
            font-size: 0.875rem;
        }

        .table tbody tr:hover {
            background: var(--background);
        }

        .badge {
            padding: 0.25rem 0.75rem;
            border-radius: 9999px;
            font-size: 0.75rem;
            font-weight: 600;
        }

        .badge-success {
            background: rgba(16, 185, 129, 0.1);
            color: var(--success);
        }


         /* Invoice Notes Section - REDESIGNED */
         .invoice-notes-panel {
             background: var(--surface);
             border: 1px solid var(--border);
             border-radius: 1rem;
             padding: 1.5rem;
             margin-bottom: 2rem;
         }

         .invoice-header {
             display: flex;
             justify-content: space-between;
             align-items: center;
             margin-bottom: 1.5rem;
             padding-bottom: 1rem;
             border-bottom: 1px solid var(--border);
         }

         .invoice-number {
             font-size: 0.875rem;
             color: var(--text-secondary);
         }

         .invoice-number span {
             color: var(--primary);
             font-weight: 600;
         }

         .view-invoice-btn {
             padding: 0.5rem 1rem;
             border: none;
             border-radius: 0.5rem;
             color: white;
             cursor: pointer;
             font-size: 0.875rem;
             font-weight: 600;
             text-decoration: none;
             transition: all 0.2s ease;
             display: inline-block;
         }

         .view-invoice-btn:hover {
             transform: translateY(-1px);
             box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
         }

         .notes-grid {
             display: grid;
             grid-template-columns: 1fr 1fr;
             gap: 1.5rem;
         }

         .note-input-section {
             background: var(--background);
             border: 1px solid var(--border);
             border-radius: 0.75rem;
             padding: 1.25rem;
         }

         .section-title {
             font-size: 0.875rem;
             font-weight: 600;
             color: var(--text-primary);
             margin-bottom: 1rem;
             display: flex;
             align-items: center;
             gap: 0.5rem;
         }

         .section-title::before {
             font-size: 1rem;
         }

         .note-form {
             display: flex;
             flex-direction: column;
             gap: 0.75rem;
         }

         .note-textarea {
             width: 100%;
             min-height: 120px;
             padding: 0.75rem;
             background: var(--surface);
             border: 1px solid var(--border);
             border-radius: 0.5rem;
             color: var(--text-primary);
             font-size: 0.875rem;
             font-family: inherit;
             resize: vertical;
             transition: all 0.2s ease;
         }

         .note-textarea:focus {
             outline: none;
             border-color: var(--primary);
             box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
         }

         .note-textarea::placeholder {
             color: var(--text-secondary);
         }

         .submit-btn {
             padding: 0.625rem 1.25rem;
             border: none;
             border-radius: 0.5rem;
             cursor: pointer;
             font-size: 0.875rem;
             font-weight: 500;
             transition: all 0.2s ease;
             align-self: flex-start;
         }

         .submit-btn:hover {
             transform: translateY(-1px);
             box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
         }

         .notes-display-section {
             background: var(--background);
             border: 1px solid var(--border);
             border-radius: 0.75rem;
             padding: 1.25rem;
         }

         .notes-list {
             display: flex;
             flex-direction: column;
             gap: 0.75rem;
             max-height: 200px;
             overflow-y: auto;
         }

         .note-item {
             background: var(--surface);
             border: 1px solid var(--border);
             border-radius: 0.5rem;
             padding: 0.875rem;
             font-size: 0.875rem;
             line-height: 1.5;
             color: var(--text-primary);
             transition: all 0.2s ease;
         }

         .note-item:hover {
             border-color: var(--primary);
             background: rgba(59, 130, 246, 0.05);
         }

         .empty-notes {
             text-align: center;
             color: var(--text-secondary);
             font-size: 0.875rem;
             padding: 2rem;
         }

         /* Scrollbar styling */
         .notes-list::-webkit-scrollbar {
             width: 6px;
         }

         .notes-list::-webkit-scrollbar-track {
             background: var(--background);
             border-radius: 3px;
         }

         .notes-list::-webkit-scrollbar-thumb {
             background: var(--border);
             border-radius: 3px;
         }

         .notes-list::-webkit-scrollbar-thumb:hover {
             background: var(--primary);
         }


        /* Responsive */
        @media (max-width: 1024px) {
            .sidebar {
                width: 14rem;
            }
        
            .main-content {
                margin-left: 14rem;
                width: calc(100% - 14rem);
            }
        
            .dashboard-grid {
                grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
            }
    }

        @media (max-width: 768px) {
            .sidebar {
                transform: translateX(-100%);
                position: fixed;
            }

            .main-content {
                margin-left: 0;
                width: 100%;
            }

            .top-nav {
                padding: 1rem;
            }

            .search-input {
                width: 10rem;
            }

            .dashboard-content {
                padding: 1rem;
            }

            .dashboard-title {
                flex-direction: column;
                align-items: flex-start;
            }

            .dashboard-actions {
                width: 100%;
                flex-wrap: wrap;
            }

            .dashboard-grid {
                grid-template-columns: 1fr;
            }

            .chart-container {
                height: 15rem;
            }

            .table {
                font-size: 0.75rem;
            }

            .table th,
            .table td {
                padding: 0.75rem 0.5rem;
            }
        }
    </style>
</head>

<body>
    <div class="app-container">
        <!-- Sidebar -->
        <aside class="sidebar">
            <div class="sidebar-header">
                <div class="logo">
                    <!-- <div class="logo-icon">📊</div> -->
                    <span>InvoiceIQ</span>
                </div>
            </div>

            <nav class="sidebar-nav">
                <div class="nav-section">
                    <div class="nav-section-title">Main</div>
                    <a href="/dashboard" class="nav-item active">
                        <span>Dashboard</span>
                    </a>
                </div>

                <div class="nav-section">
                    <div class="nav-section-title">Data Sources</div>
                    <a href="/addSource" class="nav-item">
                        <span>Add Source</span>
                    </a>
                </div>
            </nav>
        </aside>

        <!-- Main Content -->
        <main class="main-content">
            <header class="top-nav">
                <div class="breadcrumb">
                    <span>InvoiceIQ</span>
                    <span>/</span>
                    <span>Dashboard</span>
                </div>

                <div class="top-nav-right">
                </div>
            </header>

            <div class="dashboard-content">
                <div class="dashboard-header">
                    <div class="dashboard-title">
                        <div>
                            <h1>Dashboard Overview</h1>
                            <p style="color: var(--text-secondary);">Monitor your personal metrics in real-time</p>
                        </div>
                        <div class="dashboard-actions">
                            <select name="chartType" id="chartType">
                                <option value="total">Total</option>
                                <option value="unit">Unit Price</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Stats Grid -->
                <div class="dashboard-grid">
                    <% if(typeof aiResponse === 'undefined'){ %>
                     <%   console.log(`aiResponse is ${typeof aiResponse}, loading dashboard without data`) %>
                    <% }else{ %>
                    <% for (const [i, item] of aiResponse.items.entries()){ %>
                        <div class="stat-card" id=<%=`${ i}`%>>
                        <div class="stat-header" id=<%=`${ i}`%>>
                            <span class="stat-title" id=<%=`${ i}`%>><%= item.description %></span>
                        </div>
                        <div id=<%=`${ i}`%> class="stat-value"> <%= item.unit_price %> </div>
                        <div id=<%=`${ i}`%> class="stat-change positive">
                            <% if(userCharts[userCharts.length - 2].aiResponse.items[i].unit_price < userCharts[userCharts.length - 1].aiResponse.items[i].unit_price ) { %>
                                <span id=<%=`${ i}`%>>🡵</span>
                            <% }else { %>
                                <span id=<%=`${ i}`%>>🡶</span>
                            <% } %>
                            <span id=<%=`${ i}`%>>12% from last week</span>
                        </div>
                    </div>
                    <% } %>
                <% } %>
                </div>

                <!-- Chart Panel -->
                <div class="chart-panel">
                    <div class="panel-header">
                        <h3 class="panel-title">Activity Trends</h3>
                    </div>
                    <div class="chart-container">
                        <canvas id="activityChart"></canvas>
                    </div>
                </div>
                <div class="stat-card" id="invoice"></div>
            </div>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script src="main.js"></script>
</body>

</html>