<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>InvoiceIQ - Add Data Source</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #3b82f6;
            --secondary: #8b5cf6;
            --background: #0f172a;
            --surface: #1e293b;
            --text-primary: #f8fafc;
            --text-secondary: #cbd5e1;
            --border: #334155;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: var(--background);
            color: var(--text-primary);
            overflow-x: hidden;
        }

        .app-container {
            display: flex;
            min-height: 100vh;
            width: 100%;
        }

        .sidebar {
            width: 16rem;
            background: var(--surface);
            border-right: 1px solid var(--border);
            padding: 1.5rem;
            position: fixed;
            height: 100vh;
            overflow-y: auto;
            flex-shrink: 0;
        }

        .sidebar-header {
            margin-bottom: 2rem;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            font-size: 1.5rem;
            font-weight: 700;
        }

        .sidebar-nav {
            display: flex;
            flex-direction: column;
            gap: 2rem;
        }

        .nav-section-title {
            font-size: 0.75rem;
            font-weight: 600;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 0.5rem;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.75rem 1rem;
            border-radius: 0.5rem;
            color: var(--text-secondary);
            text-decoration: none;
            transition: all 0.2s ease;
            font-size: 0.875rem;
        }

        .nav-item:hover {
            background: var(--background);
            color: var(--text-primary);
        }

        .nav-item.active {
            background: var(--primary);
            color: white;
        }

        .main-content {
            flex: 1;
            margin-left: 16rem;
            width: calc(100% - 16rem);
        }

        .top-nav {
            background: var(--surface);
            border-bottom: 1px solid var(--border);
            padding: 1rem 2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .breadcrumb {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            color: var(--text-secondary);
            font-size: 0.875rem;
        }

        .page-content {
            padding: 2rem;
            max-width: 100%;
        }

        .page-header {
            margin-bottom: 2rem;
        }

        .page-header h1 {
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
        }

        .page-header p {
            color: var(--text-secondary);
        }

        .alert {
            padding: 1rem;
            border-radius: 0.75rem;
            margin-bottom: 1.5rem;
            display: none;
            align-items: center;
            gap: 0.5rem;
        }

        .alert-success {
            background: rgba(16, 185, 129, 0.1);
            border: 1px solid #10b981;
            color: #10b981;
        }

        .chart-panel {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 1rem;
            padding: 1.5rem;
            margin-bottom: 2rem;
        }

        .panel-header {
            margin-bottom: 1.5rem;
        }

        .panel-title {
            font-size: 1.25rem;
            font-weight: 600;
            margin-bottom: 0.5rem;
        }

        .form-group {
            margin-bottom: 1.5rem;
        }

        .form-label {
            display: block;
            margin-bottom: 0.5rem;
            font-weight: 500;
            font-size: 0.875rem;
            color: var(--text-secondary);
        }

        .form-input,
        .form-select {
            width: 100%;
            padding: 0.75rem 1rem;
            background: var(--background);
            border: 1px solid var(--border);
            border-radius: 0.5rem;
            color: var(--text-primary);
            font-size: 0.875rem;
            transition: all 0.2s ease;
        }

        .form-input:focus,
        .form-select:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
        }

        .containerData {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .mb-3 {
            margin-bottom: 1rem;
        }

        .form-control {
            width: 100%;
            padding: 0.75rem 1rem;
            background: var(--background);
            border: 1px solid var(--border);
            border-radius: 0.5rem;
            color: var(--text-primary);
            font-size: 0.875rem;
        }

        .form-control:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
        }

        @media (max-width: 1024px) {
            .sidebar {
                width: 14rem;
            }

            .main-content {
                margin-left: 14rem;
                width: calc(100% - 14rem);
            }
        }

        @media (max-width: 768px) {
            .sidebar {
                transform: translateX(-100%);
                position: fixed;
            }

            .main-content {
                margin-left: 0;
                width: 100%;
            }

            .top-nav {
                padding: 1rem;
            }

            .page-content {
                padding: 1rem;
            }
        }
    </style>
</head>

<body>
    <div class="app-container">
        <!-- Sidebar -->
        <aside class="sidebar">
            <div class="sidebar-header">
                <div class="logo">
                    <span>InvoiceIQ</span>
                </div>
            </div>

            <nav class="sidebar-nav">
                <div class="nav-section">
                    <div class="nav-section-title">Main</div>
                    <a href="/dashboard" class="nav-item">
                        <div class="nav-icon">
                            <svg class="icon" viewBox="0 0 24 24">
                                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                                <polyline points="9 22 9 12 15 12 15 22"></polyline>
                            </svg>
                        </div>
                        <span>Dashboard</span>
                    </a>
                </div>

                <div class="nav-section">
                    <div class="nav-section-title">Data Sources</div>
                    <a href="/addSource" class="nav-item active">
                        <span>Add Source</span>
                    </a>
                </div>
            </nav>
        </aside>

        <!-- Main Content -->
        <main class="main-content">
            <header class="top-nav">
                <div class="breadcrumb">
                    <span>InvoiceIQ</span>
                    <span>/</span>
                    <span>Data Sources</span>
                    <span>/</span>
                    <span>Add Source</span>
                </div>

                <div class="top-nav-right">
                </div>
            </header>

            <div class="page-content">
                <section class="containerData">
                    <div class="page-header">
                        <h1>Add Data Source</h1>
                        <p>Connect external services to track and visualize your personal metrics</p>
                        <form action="/post/createManualInvoice" enctype="multipart/form-data" method="POST">
                            <div class="mb-3">
                                <label for="title" class="form-label">Title</label>
                                <input type="text" class="form-control" id="title" name="title">
                            </div>
                            <div class="mb-3">
                                <label for="caption" class="form-label">Caption</label>
                                <textarea class="form-control" id="caption" name="caption"></textarea>
                            </div>
                            <div class="mb-3">
                                <label for="imgUpload" class="form-label">Image</label>
                                <input type="file" class="form-control" id="imageUpload" multiple name="file">
                            </div>
                            <button type="submit">Submit!</button>
                        </form>
                    </div>
                    <!-- <form action="/gmailAuth" method="GET">
                            <button type="submit">Auth with Gmail</button>
                        </form> -->
                </section>
                <div id="successAlert" class="alert alert-success">
                    Data source connected successfully!
                </div>

                <div id="manualEntryAlert" class="alert alert-success">
                    Manual data entry added successfully!
                </div>

                <!-- Manual Entry Section -->
                <div class="chart-panel" style="margin-bottom: 3rem;">
                    <div class="panel-header">
                        <h3 class="panel-title">Quick Manual Entry</h3>

                        <p style="color: var(--text-secondary); font-size: 0.875rem; margin: 0;">Add data points
                            manually</p>
                    </div>

                    <form id="manualEntryForm" onsubmit="handleManualEntry(event)" action="/post/addSource"
                        method="POST">
                        <div
                            style="display: grid; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); gap: 1rem; margin-bottom: 1rem;">
                            <div class="form-group" style="margin-bottom: 0;">
                                <label class="form-label" for="category">Category</label>
                                <select name="category" id="metricCategory" class="form-select" required>
                                    <option value="">Select category...</option>
                                    <option value="finance">Finance</option>
                                    <option value="fitness">Fitness</option>
                                    <option value="productivity">Productivity</option>
                                    <option value="health">Health</option>
                                    <option value="mood">Mood</option>
                                    <option value="sleep">Sleep</option>
                                    <option value="custom">Custom</option>
                                </select>
                            </div>

                            <div class="form-group" style="margin-bottom: 0;">
                                <label class="form-label" for="name">Metric Name</label>
                                <input name="name" type="text" id="metricName" class="form-input"
                                    placeholder="e.g., Coffee Purchase" required>
                            </div>

                            <div class="form-group" style="margin-bottom: 0;">
                                <label class="form-label" for="metricValue">Value</label>
                                <input name="value" type="number" step="0.01" id="metricValue" class="form-input"
                                    placeholder="e.g., 5.50" required>
                            </div>

                            <div class="form-group" style="margin-bottom: 0;">
                                <label class="form-label" for="metricDate">Date</label>
                                <input name="date" type="date" id="metricDate" class="form-input" required>
                            </div>
                        </div>

                        <div class="form-group" style="margin-bottom: 1rem;">
                            <label class="form-label" for="metricNotes">Notes (Optional)</label>
                            <input name="notes" type="text" id="metricNotes" class="form-input"
                                placeholder="Add a note about this entry...">
                        </div>
                    </form>
                </div>
            </div>
        </main>
    </div>
    <script src="main.js"></script>
</body>

</html>